Q2. Recursive function to calculate factorial (10 marks)
Program key: factorial recursive. REPEATED 2 times — Slip 20 Q2, Slip 28 Q2
#include <stdio.h>
long long factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}
int main(void) {
    int n;
    printf("Enter a non-negative integer: "); scanf("%d", &n);
    if (n < 0) printf("Factorial is not defined for negative numbers\n");
    else printf("Factorial = %lld\n", factorial(n));
    return 0;
}
Q3. Accept n numbers in an array; calculate sum and average (10 marks)
Program key: array sum average. REPEATED 3 times — Slip 20 Q3, Slip 22 Q3, Slip 28 Q3
#include <stdio.h>
int main(void) {
    int a[100], n, i, sum = 0;
    float average;
    printf("Enter number of elements: "); scanf("%d", &n);
    if (n < 1 || n > 100) return 0;
    for (i = 0; i < n; i++) { scanf("%d", &a[i]); sum += a[i]; }
    average = (float)sum / n;
    printf("Sum = %d\nAverage = %.2f\n", sum, average);
    return 0;
}
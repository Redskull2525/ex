Q2. Find ceiling division of two numbers and handle division by zero; use the hint as written in the question (10 marks)
Program key: ceil division. Appears once in this slip set.
#include <stdio.h>
int main(void) {
    int a, b, q;
    printf("Enter numerator and denominator: "); scanf("%d%d", &a, &b);
    if (b == 0) {
        printf("Error: division by zero\n");
    } else {
        /* For positive integers, ceil(a/b) = (a + b - 1) / b.
           This version also works for negative values by using double ceil logic. */
        double value = (double)a / b;
        q = (int)value;
        if (value > q) q++;
        printf("Ceiling division = %d\n", q);
    }
    return 0;
}
Q3. Find the largest number in an array (10 marks)
Program key: largest array. REPEATED 2 times — Slip 13 Q3, Slip 26 Q3
#include <stdio.h>
int main(void) {
    int a[100], n, i, max;
    printf("Enter number of elements: "); scanf("%d", &n);
    if (n < 1 || n > 100) return 0;
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    max = a[0];
    for (i = 1; i < n; i++) if (a[i] > max) max = a[i];
    printf("Largest = %d\n", max);
    return 0;
}
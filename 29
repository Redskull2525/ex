Q2. Accept Fahrenheit; print Celsius and Kelvin (10 marks)
Program key: temperature. REPEATED 3 times — Slip 1 Q2, Slip 19 Q2, Slip 29 Q2
#include <stdio.h>
int main(void) {
    float f, c, k;
    printf("Enter temperature in Fahrenheit: ");
    scanf("%f", &f);
    c = (5.0 / 9.0) * (f - 32);
    k = c + 273.15;
    printf("Celsius = %.2f\nKelvin = %.2f\n", c, k);
    return 0;
}
Q3. Menu-driven switch arithmetic for +, -, *, /, % (10 marks)
Program key: menu mod. REPEATED 2 times — Slip 19 Q3, Slip 29 Q3
#include <stdio.h>
int main(void) {
    int a, b;
    char op;
    printf("Enter two integers: "); scanf("%d%d", &a, &b);
    printf("Enter operator (+, -, *, /, %%): "); scanf(" %c", &op);
    switch (op) {
        case '+': printf("Result = %d\n", a+b); break;
        case '-': printf("Result = %d\n", a-b); break;
        case '*': printf("Result = %d\n", a*b); break;
        case '/':
            if (b == 0) printf("Error: division by zero\n");
            else printf("Result = %.2f\n", (float)a/b);
            break;
        case '%':
            if (b == 0) printf("Error: division by zero\n");
            else printf("Remainder = %d\n", a%b);
            break;
        default: printf("Invalid operator\n");
    }
    return 0;
}
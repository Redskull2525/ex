Q1. Accept n array elements and display them (5 marks)
Program key: array display. REPEATED 2 times — Slip 5 Q1, Slip 27 Q1
#include <stdio.h>
int main(void) {
    int a[100], n, i;
    printf("Enter number of elements: "); scanf("%d", &n);
    if (n < 1 || n > 100) return 0;
    for (i = 0; i < n; i++) { printf("Element: "); scanf("%d", &a[i]); }
    printf("Array elements: ");
    for (i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\n");
    return 0;
}
Q2. Accept three numbers and check whether the first number is between the other two (10 marks)
Program key: between three. Appears once in this slip set.
#include <stdio.h>
int main(void) {
    int a, b, c, low, high;
    printf("Enter three numbers (first, second, third): ");
    scanf("%d%d%d", &a, &b, &c);
    low = (b < c) ? b : c;
    high = (b > c) ? b : c;
    if (a >= low && a <= high)
        printf("%d is between %d and %d\n", a, low, high);
    else printf("%d is not between %d and %d\n", a, low, high);
    return 0;
}
Q3. Read ages of n persons and count those aged 40 to 50, using continue (10 marks)
Program key: age 40 50. Appears once in this slip set.
#include <stdio.h>
int main(void) {
    int n, i, age, count = 0;
    printf("How many persons? "); scanf("%d", &n);
    for (i = 1; i <= n; i++) {
        printf("Enter age: "); scanf("%d", &age);
        if (age < 40 || age > 50) continue;
        count++;
    }
    printf("Persons aged 40 to 50 = %d\n", count);
    return 0;
}
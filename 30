Q1. Check whether a given number is positive or negative (5 marks)
Program key: positive negative. REPEATED 2 times — Slip 24 Q1, Slip 30 Q1
#include <stdio.h>
int main(void) {
    int n;
    printf("Enter a number: "); scanf("%d", &n);
    if (n > 0) printf("Positive\n");
    else if (n < 0) printf("Negative\n");
    else printf("Zero\n");
    return 0;
}
Q2. Check whether a number is divisible by both 5 and 7 (10 marks)
Program key: divisible 5 7. REPEATED 2 times — Slip 26 Q2, Slip 30 Q2
#include <stdio.h>
int main(void) {
    int n;
    printf("Enter a number: "); scanf("%d", &n);
    if (n % 5 == 0 && n % 7 == 0)
        printf("Divisible by both 5 and 7\n");
    else printf("Not divisible by both 5 and 7\n");
    return 0;
}
Q3. Accept an integer and count its digits (10 marks)
Program key: digit count. REPEATED 2 times — Slip 16 Q3, Slip 30 Q3
#include <stdio.h>
int main(void) {
    int n, count = 0;
    printf("Enter an integer: "); scanf("%d", &n);
    if (n == 0) count = 1;
    while (n != 0) { count++; n /= 10; }
    printf("Number of digits = %d\n", count);
    return 0;
}
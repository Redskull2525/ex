Q1. Display the sum of the first n numbers (5 marks)
Program key: sum first n. Appears once in this slip set.
#include <stdio.h>
int main(void) {
    int n, i, sum = 0;
    printf("Enter n: "); scanf("%d", &n);
    for (i = 1; i <= n; i++) sum += i;
    printf("Sum = %d\n", sum);
    return 0;
}
Q2. Check whether a number is divisible by both 5 and 7 (10 marks)
Program key: divisible 5 7. REPEATED 2 times — Slip 26 Q2, Slip 30 Q2
#include <stdio.h>
int main(void) {
    int n;
    printf("Enter a number: "); scanf("%d", &n);
    if (n % 5 == 0 && n % 7 == 0)
        printf("Divisible by both 5 and 7\n");
    else printf("Not divisible by both 5 and 7\n");
    return 0;
}
Q3. Find the largest element in an array (10 marks)
Program key: largest array. REPEATED 2 times — Slip 13 Q3, Slip 26 Q3
#include <stdio.h>
int main(void) {
    int a[100], n, i, max;
    printf("Enter number of elements: "); scanf("%d", &n);
    if (n < 1 || n > 100) return 0;
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    max = a[0];
    for (i = 1; i < n; i++) if (a[i] > max) max = a[i];
    printf("Largest = %d\n", max);
    return 0;
}
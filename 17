Q1. Accept n array elements and display them in reverse order (5 marks)
Program key: array reverse. Appears once in this slip set.
#include <stdio.h>
int main(void) {
    int a[100], n, i;
    printf("Enter number of elements: "); scanf("%d", &n);
    if (n < 1 || n > 100) return 0;
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    printf("Reverse order: ");
    for (i = n - 1; i >= 0; i--) printf("%d ", a[i]);
    printf("\n");
    return 0;
}
Q2. Display reverse of a number using while loop (10 marks)
Program key: number reverse. Appears once in this slip set.
#include <stdio.h>
int main(void) {
    int n, digit, rev = 0;
    printf("Enter a number: "); scanf("%d", &n);
    while (n != 0) {
        digit = n % 10;
        rev = rev * 10 + digit;
        n /= 10;
    }
    printf("Reverse = %d\n", rev);
    return 0;
}
Q3. Input marks in Physics, Chemistry, Biology, Mathematics and Computer; calculate percentage and grade using given thresholds (10 marks)
Program key: marks grade. REPEATED 2 times — Slip 17 Q3, Slip 25 Q3
#include <stdio.h>
int main(void) {
    float p, c, b, m, comp, total, percentage;
    char grade;
    printf("Enter marks for Physics Chemistry Biology Mathematics Computer: ");
    scanf("%f%f%f%f%f", &p, &c, &b, &m, &comp);
    total = p + c + b + m + comp;
    percentage = total / 5.0;
    if (percentage >= 90) grade = 'A';
    else if (percentage >= 80) grade = 'B';
    else if (percentage >= 70) grade = 'C';
    else if (percentage >= 60) grade = 'D';
    else if (percentage >= 40) grade = 'E';
    else grade = 'F';
    printf("Percentage = %.2f%%\nGrade = %c\n", percentage, grade);
    return 0;
}